target/
m0-data/
*.db
*.db-wal
*.db-shm
*.tshm
*.blobs/
m0-data/
demo*.db*
name-reservation/

# ...except the committed demo memory the README screenshots are taken from.
# Rebuild it with scripts/build_demo.sh; it is ~800 KB and travels as one file.
!data/demo.db
!data/demo.db.telemetry.db

# example scratch output (smoke.sh writes the "posted" sheet and outbox here)
examples/agents/*/out/
# Agent-example language stacks: run artifacts, deps, and the Rust stack's
# detached lockfile (path deps make it drift with every release bump).
examples/agents/*/*/out/
examples/agents/*/typescript/node_modules/
examples/agents/*/typescript/package-lock.json
examples/agents/*/rust/Cargo.lock

# python bytecode
__pycache__/
*.pyc

# cargo-mutants output
mutants.out/
mutants.out.old/

# scratch/draft lineage (kept local, not for the repo)
docs/tmp/

# macOS Finder cruft
.DS_Store

# Local Python virtualenvs. `examples/agents/docs/testing.md` and the CI job
# both create one at the repo root to build the binding with maturin; it is a
# build artifact, never a repo artifact.
.venv/
venv/
