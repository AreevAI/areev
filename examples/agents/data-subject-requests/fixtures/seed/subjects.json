{
  "_comment": [
    "The synthetic memory this desk operates on. Entirely fictional people,",
    "addresses and reference numbers. `age_days` is how old the grain is at",
    "seed time -- the retention sweep in improve.sh reads it back through",
    "created_at, so the fixture, not the wall clock, decides what is old."
  ],

  "processing_register": [
    { "namespace": "org.crm",     "purpose": "customer relationship management", "lawful_basis": "contract" },
    { "namespace": "org.support", "purpose": "support ticket history",           "lawful_basis": "legitimate interest" },
    { "namespace": "org.billing", "purpose": "invoicing and tax records",        "lawful_basis": "legal obligation" }
  ],

  "retention": [
    {
      "namespace": "org.support",
      "grain_type": "event",
      "max_age_days": 365,
      "because": "support conversations are kept for one year, then swept"
    },
    {
      "namespace": "org.*",
      "grain_type": "event",
      "max_age_days": 30,
      "because": "MIS-DECLARED ON PURPOSE: a blanket rule someone wrote as a prefix. Destruction takes an exact namespace, so the sweep refuses it instead of widening."
    }
  ],

  "subjects": [
    {
      "subject": "did:example:ines-bakker",
      "email": "i.bakker@example.test",
      "grains": [
        { "ns": "org.crm", "kind": "fact", "relation": "mg:contact_email", "object": "i.bakker@example.test" },
        { "ns": "org.crm", "kind": "fact", "relation": "display_name", "object": "Ines Bakker" },
        { "ns": "org.crm", "kind": "fact", "relation": "account_plan", "object": "team" },
        { "ns": "org.crm", "kind": "consent", "scope": "product-updates", "basis": "consent", "age_days": 620 },
        { "ns": "org.support", "kind": "event", "age_days": 411, "content": "Ines Bakker asked how to move a workspace between plans." },
        { "ns": "org.support", "kind": "event", "age_days": 12, "content": "Ines Bakker reported a failed export and we resent it." }
      ]
    },
    {
      "subject": "did:example:nadia-okonkwo",
